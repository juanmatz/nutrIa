# ============================================================
# NutrIA Frontend (React + Vite) - Variables de entorno de ejemplo
# Copia este archivo a `.env` según tu entorno de ejecución.
# ============================================================

# ---------- 1. URL Base de la API Backend (Django REST Framework) ----------
# Entorno de Desarrollo Local:
# Usa `/api` para aprovechar el proxy inverso de Vite y evitar problemas de CORS,
# o apunta directamente a `http://localhost:3000/api`.
VITE_API_URL=/api

# Entorno de Despliegue en Producción (Vercel):
# Reemplaza con la URL pública de tu backend Django alojado en Render, Railway, Fly.io o VPS:
# VITE_API_URL=https://api-nutria.onrender.com/api

# ---------- 2. Destino del Proxy de Desarrollo en Vite ----------
# Puerto/Host donde corre el servidor Django local (leído por `vite.config.js`).
# Por defecto: http://localhost:3000
VITE_BACKEND_PROXY=http://localhost:3000
