# ============================================================
# NutrIA Backend - Variables de entorno de ejemplo
# Copia este archivo a `.env` y completa tus credenciales.
# ============================================================

# ---------- 1. Configuración de Django ----------
# Clave secreta (en producción genera una con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
DJANGO_SECRET_KEY=django-insecure-dev-only-change-me

# Modo depuración (True en desarrollo, False en producción)
DJANGO_DEBUG=True

# Hosts permitidos, separados por comas
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api

# Puerto donde corre el backend Django (3000 por defecto para acoplamiento con Vite)
DJANGO_PORT=3000

# Zona horaria (ej. UTC, America/Mexico_City, America/Bogota)
DJANGO_TIME_ZONE=UTC

# ---------- 2. CORS & Seguridad Web ----------
# Orígenes frontend autorizados para interactuar con la API (separados por comas)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Dominios confiables para protección CSRF
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 3. Base de Datos (PostgreSQL en Docker / Producción) ----------
DB_NAME=nutria
DB_USER=nutria
# Obligatoria en PostgreSQL: define tu contraseña segura
DB_PASSWORD=nutriapassword2026
DB_HOST=localhost
DB_PORT=5432

# ---------- 4. Tokens JWT (SimpleJWT) ----------
# Duración del Access Token en días
JWT_ACCESS_TTL_DAYS=1
# Duración del Refresh Token en días
JWT_REFRESH_TTL_DAYS=7

# ---------- 5. NutriaBot AI - OpenRouter API ----------
# Clave de API de OpenRouter (obtenida en https://openrouter.ai/keys)
# Formato: sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxx
# NOTA: Si se deja vacía, NutriaBot activa automáticamente el modo Mock Bioadaptativo sin fallar.
OPENROUTER_API_KEY=

# Modelo de IA de OpenRouter a utilizar
# Por defecto: nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
